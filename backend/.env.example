# ─────────────────────────────────────────────────────────────────
# Afirmative Pill · Backend · Variables de entorno
# Copia este archivo como ".env" y completa los valores.
# ─────────────────────────────────────────────────────────────────

# Cadena de conexión PostgreSQL de Supabase
# (Project Settings → Database → Connection string → URI)
#  - Local (servidor Node persistente): usa el "Session pooler" (puerto 5432)
#  - Vercel (serverless):              usa el "Transaction pooler" (puerto 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# SSL hacia la BD (true para Supabase, false para un Postgres local en Docker)
DATABASE_SSL=true

# Tamaño máximo del pool de conexiones (en Vercel conviene 1-3)
DATABASE_POOL_MAX=10

# Secreto para firmar los JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Puerto del servidor local
PORT=4000

# Orígenes permitidos por CORS (separados por coma). * = cualquiera
CORS_ORIGIN=http://localhost:5173

# Consistencia eventual (milisegundos):
#  - PROJECTION_DELAY_MS: retardo simulado antes de proyectar eventos al read model
#  - AUTO_APPROVE_DELAY_MS: tiempo que tarda el sistema en aprobar pedidos sin fórmula (OTC)
PROJECTION_DELAY_MS=1500
AUTO_APPROVE_DELAY_MS=4000

# true = desactiva el batching de DataLoader para evidenciar el problema N+1
DISABLE_DATALOADER=false

# Logs de cada SQL ejecutado (true/false)
LOG_SQL=true

# Habilita introspección / Apollo Sandbox en /graphql
GRAPHQL_INTROSPECTION=true
