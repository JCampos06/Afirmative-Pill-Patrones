# ─────────────────────────────────────────────────────────────────
# Afirmative Pill · Frontend · Variables de entorno (Vite)
# Copia este archivo como ".env" para desarrollo local.
# ─────────────────────────────────────────────────────────────────

# Endpoint GraphQL HTTP (queries y mutations)
VITE_GRAPHQL_HTTP_URL=http://localhost:4000/graphql

# Endpoint GraphQL WebSocket (subscriptions). Si se omite, se deriva del HTTP.
VITE_GRAPHQL_WS_URL=ws://localhost:4000/graphql

# true  = seguimiento en tiempo real con GraphQL Subscriptions (servidor local)
# false = seguimiento con polling de queries (backend serverless en Vercel,
#         que no soporta WebSockets)
VITE_ENABLE_SUBSCRIPTIONS=true
