{
  "name": "afirmative-pill-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Afirmative Pill · Frontend React + Vite + Apollo Client + Tailwind",
  "type": "module",
  "scripts": {
    "codegen": "graphql-codegen --config codegen.ts",
